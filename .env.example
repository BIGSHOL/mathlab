# ── 데이터베이스 (PostgreSQL / Prisma) ──
# DATABASE_URL: 앱 런타임용 (PgBouncer 등 풀링 연결 가능)
# DIRECT_URL  : Prisma migrate/introspect용 직접 연결 (풀링 우회)
DATABASE_URL=postgresql://user:password@localhost:5432/mathlab
DIRECT_URL=postgresql://user:password@localhost:5432/mathlab

# ── 인증 (NextAuth) ──
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# ── 사이트 공개 URL (차트/공유 이미지 절대 URL용) ──
# 블로그용 차트 이미지의 절대 URL 생성에 사용. 미설정 시 fallback 도메인 사용.
# 배포 도메인 변경 시 이 값만 교체 (예: https://mathlab.para-x.co.kr).
NEXT_PUBLIC_SITE_URL=

# ── AI (기출분석) ──
# GEMINI    : 시험지 OCR·문항 분석 (발급: https://aistudio.google.com/apikey)
# ANTHROPIC : 해설·총평 생성 (발급: https://console.anthropic.com/settings/keys)
GEMINI_API_KEY=your-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# 로컬 next dev 에서 기출분석을 외부 SDK 대신 설치된 CLI 로 돌릴 때
# EXAM_ANALYSIS_PROVIDER=cli     # cli | gemini  (미설정+dev+CLI있음 → cli)
# EXAM_ANALYSIS_CLI=auto         # auto | grok | claude | codex
# 운영(Vercel / next start)에서는 무시되고 항상 GEMINI 경로.

# ── Supabase Storage (시험지 PDF 업로드 — 'uploads' 버킷) ──
# SUPABASE_URL              : 프로젝트 URL (Settings → API → Project URL)
# SUPABASE_SERVICE_ROLE_KEY : service_role 키 (서버 전용 — 클라이언트 노출 금지)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── 배치 추출 cron (선택 — /api/cron/extract-batch-tick 보호용) ──
CRON_SECRET=your-cron-secret

# ── 결제 (Lemon Squeezy) — 지점 단위 구독. 전부 빈값이면 데모/Free 모드로 안전 동작 ──
# API_KEY/STORE_ID/WEBHOOK_SECRET 발급: https://app.lemonsqueezy.com/settings
# VARIANT_*: 상품(Product) 안의 Variant ID (Pro/Enterprise 각각)
# webhook URL은 LS 대시보드에 /api/webhooks/lemonsqueezy 로 등록
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_ENTERPRISE=
# 선택: 1이면 LS 미설정 상태에서도 체크아웃이 해당 플랜으로 즉시 업그레이드 (유료 게이팅 테스트용)
ALLOW_DEMO_UPGRADE=
# 베타 기간: 1이면 모든 지점이 최소 Pro로 동작(상위 플랜은 유지). 베타 종료 시 비우거나 0.
BETA_ALL_PRO=

# ── 결제 허브 (Para-X) — 이용권 지급 통지 수신 ──
# para-x → mathlab grant 웹훅(/api/webhooks/parax)의 HMAC 서명 검증용.
# para-x 쪽 PARAX_SHARED_SECRET 와 반드시 동일 값이어야 함.
PARAX_SHARED_SECRET=

# 구독 결제(Phase 4): 결제페이지 '구독하기' → para-x 체크아웃 URL (NEXT_PUBLIC_ = 클라이언트 노출)
# 로컬 http://localhost:3000/checkout.html · 운영 https://para-x.co.kr/checkout.html
NEXT_PUBLIC_PARAX_CHECKOUT_URL=

# mathlab → para-x 핸드오프 토큰 발급용. para-x 쪽 HANDOFF_SHARED_SECRET 와 반드시 동일 값.
HANDOFF_SHARED_SECRET=

# ���� ���� ���� �˸� - para-x ������ ���� Web3Forms Ű (�̼��� �� ���� ����, ������ ����)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
