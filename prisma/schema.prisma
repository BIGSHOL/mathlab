// FEAT: Question Homework Plans (문제은행 숙제)
model QuestionHomeworkPlan {
  id              String   @id @default(cuid())
  seq             Int      @unique @default(autoincrement())
  title           String   @db.VarChar(200)
  createdBy       String
  startDate       DateTime @db.Date
  totalDays       Int
  dailyQuestions  Json     // string[][] - 날짜별 문제 ID 배열
  passingScore    Int      @default(80)
  isActive        Boolean  @default(true)
  tenantId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant           Tenant?                       @relation(fields: [tenantId], references: [id])
  creator          User                          @relation("QuestionHomeworkPlanCreator", fields: [createdBy], references: [id])
  enrollments      QuestionHomeworkEnrollment[]
  attempts         QuestionHomeworkAttempt[]
  homeworkQuestions HomeworkQuestion[]

  @@index([createdBy])
  @@index([isActive])
  @@index([startDate])
  @@index([tenantId])
}

model QuestionHomeworkEnrollment {
  id         String   @id @default(cuid())
  planId     String
  studentId  String
  enrolledAt DateTime @default(now())

  plan    QuestionHomeworkPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  student User                @relation("QuestionHomeworkEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([planId, studentId])
  @@index([studentId])
  @@index([planId])
}

model QuestionHomeworkAttempt {
  id           String    @id @default(cuid())
  planId       String
  studentId    String
  dayIndex     Int
  answers      Json      // { questionId: string, selectedAnswer: string, isCorrect: boolean }[]
  correctCount Int       @default(0)
  totalCount   Int       @default(0)
  score        Int       @default(0) // 정답률 %
  completedAt  DateTime?
  createdAt    DateTime  @default(now())

  plan    QuestionHomeworkPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  student User               @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([planId, studentId, dayIndex])
  @@index([studentId])
}

// FEAT: Quiz Answer Detail Log
model QuizAnswerLog {
  id               String   @id @default(cuid())
  participantId    String
  questionId       String
  questionIndex    Int
  selectedAnswer   String   @db.Text
  correctAnswer    String   @db.Text
  isCorrect        Boolean
  timeSpentSeconds Int      @default(0)
  pointsEarned     Int      @default(0)
  createdAt        DateTime @default(now())

  participant QuizParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, questionId])
  @@index([participantId])
}

// FEAT: Student Concept Memo
model ConceptMemo {
  id        String   @id @default(cuid())
  userId    String
  conceptId String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([userId])
