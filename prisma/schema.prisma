// MathLab Database Schema
// Based on docs/planning/04-database-design.md

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// FEAT-0: User Management
enum Role {
  STUDENT
  TEACHER
  MANAGER
  OWNER
  SUPER_ADMIN
}

// FEAT: 이용권(라이선스) 시스템 — 기능별 좌석 관리
enum LicenseFeature {
  CONCEPT
  ARITHMETIC
  TIME_ATTACK
  TEST
  REVENGE
  DIAGNOSTIC
  QUIZ
  EXAM_ANALYSIS
  HOMEWORK
  WORKSHEET
  EXAM_PREP
}

// FEAT: 기출 분석 시스템
enum ExamPaperStatus {
  PENDING
  ANALYZING
  COMPLETED
  FAILED
}

enum ExamSubject {
  MATH
  ENGLISH
}

// FEAT: 멀티테넌시 — 지점(학원) 관리
model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique @db.VarChar(50)   // 서브도메인: "gangnam" → gangnam.mathlab.com
  name      String   @db.VarChar(100)           // 표시명: "강남점"
  logo      String?  @db.VarChar(500)           // 커스텀 로고 URL
  settings  Json?                                // 지점별 설정 (색상, 기능 토글 등)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                  User[]
  classrooms             Classroom[]
  tests                  Test[]
  learningCourses        LearningCourse[]
  arithmeticHomeworkPlans ArithmeticHomeworkPlan[]
  conceptHomeworkPlans   ConceptHomeworkPlan[]
  questionHomeworkPlans  QuestionHomeworkPlan[]
  quizSessions           QuizSession[]
  dailyQuestions         DailyQuestion[]
  featureFlags           FeatureFlag[]
  tenantLicenses         TenantLicense[]
  nearbyGroups           TenantNearbyGroup[]
  questions              Question[]
  classCompetitionWeeks  ClassCompetitionWeek[]
  examCampaigns          ExamCampaign[]

  @@index([slug])
  @@index([isActive])
}

model User {
  id            String    @id @default(cuid())
  seq           Int       @unique @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  passwordHash  String    @db.VarChar(255)
  name          String    @db.VarChar(50)
  role          Role      @default(STUDENT)
  grade         Int?
  phone         String?   @db.VarChar(20)
  email         String?   @db.VarChar(100)
  school        String?   @db.VarChar(100)
  birthDate     DateTime?
  address       String?   @db.VarChar(200)
  startDate     DateTime?
  notes         String?   @db.Text
  parentName    String?   @db.VarChar(50)
  parentPhone   String?   @db.VarChar(20)
  classroomId   String?
  tenantId      String?
  profileImage  String?   @db.VarChar(500)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  tenant         Tenant?   @relation(fields: [tenantId], references: [id])
  sessions       Session[]
  profile        StudentProfile?
  progress       LearningProgress[]
  transactions   PointTransaction[]
  createdTests   Test[]          @relation("TestCreator")
  testAttempts   TestAttempt[]   @relation("StudentAttempts")
  assignments    TestAssignment[] @relation("StudentAssignments")
  inquiries      Inquiry[]       @relation("InquiryAuthor")
  repliedInquiries Inquiry[]     @relation("InquiryReplier")
  arithmeticAttempts ArithmeticAttempt[]
  conceptMemos       ConceptMemo[]
  teacherComments    TeacherComment[] @relation("TeacherComments")
  studentComments    TeacherComment[] @relation("StudentComments")
  generationLogs     QuestionGenerationLog[]
  createdHomeworkPlans   ArithmeticHomeworkPlan[]        @relation("HomeworkPlanCreator")
  homeworkEnrollments    ArithmeticHomeworkEnrollment[]   @relation("HomeworkEnrollments")
  createdConceptHomeworkPlans ConceptHomeworkPlan[]       @relation("ConceptHomeworkPlanCreator")
  conceptHomeworkEnrollments  ConceptHomeworkEnrollment[] @relation("ConceptHomeworkEnrollments")
  createdQuestionHomeworkPlans QuestionHomeworkPlan[]     @relation("QuestionHomeworkPlanCreator")
  questionHomeworkEnrollments  QuestionHomeworkEnrollment[] @relation("QuestionHomeworkEnrollments")
  questionHomeworkAttempts     QuestionHomeworkAttempt[]
  classroom                    Classroom?                       @relation(fields: [classroomId], references: [id])
  timeAttackRecords            TimeAttackRecord[]
  dailyQuestionAttempts        DailyQuestionAttempt[]
  dailyMissions                DailyMission[]
  badges                       UserBadge[]
  learningCourseEnrollments    LearningCourseEnrollment[] @relation("LearningCourseEnrollments")
  createdLearningCourses       LearningCourse[]           @relation("LearningCourseCreator")
  blankAttempts                BlankAttempt[]
  revengeAttempts              RevengeAttempt[]
  reviewSchedules              ReviewSchedule[]  @relation("UserReviews")
  studentLicenses              StudentLicense[]  @relation("StudentLicenses")
  assignedLicenses             StudentLicense[]  @relation("LicenseAssignedBy")
  examPapersAsTeacher          ExamPaper[]       @relation("ExamPaperTeacher")
  examPapersAsStudent          ExamPaper[]       @relation("ExamPaperStudent")
  createdQuestions             Question[]        @relation("createdQuestions")
  inventories                  UserInventory[]
  createdExamCampaigns         ExamCampaign[]    @relation("ExamCampaignCreator")
  examCampaignEnrollments      ExamCampaignEnrollment[] @relation("ExamCampaignEnrollments")

  @@index([role])
  @@index([classroomId])
  @@index([tenantId])
  @@index([tenantId, role])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// FEAT-1: Subject & Concept
model Subject {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(200)
  description String?  @db.Text
  gradeLevel  Int
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  concepts Concept[]

  @@index([gradeLevel])
  @@index([sortOrder])
}

model Concept {
  id           String   @id @default(cuid())
  subjectId    String
  title        String   @db.VarChar(200)
  fullContent  String   @db.Text
  visualAssets Json?
  sortOrder    Int      @default(0)
  conceptCode  String?  @unique @db.VarChar(20)
  grade        String?  @db.VarChar(20)
  semester     Int?                        // 학기: 1 또는 2
  chapter      String?  @db.VarChar(100)   // 대단원: "자연수의 혼합 계산"
  section      String?  @db.VarChar(100)   // 중단원: "덧셈과 뺄셈이 섞여 있는 식"
  sectionSub   String?  @db.VarChar(100)   // 소단원
  category     String?  @db.VarChar(20)
  part         String?  @db.VarChar(20)
  source       String?  @db.VarChar(200)   // 출처
  keywords     String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subject          Subject              @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  blanks           BlankExercise[]
  progress         LearningProgress[]
  prerequisiteFor  ConceptPrerequisite[] @relation("PrerequisiteFor")
  prerequisites    ConceptPrerequisite[] @relation("HasPrerequisite")
  questions              Question[]
  learningCourseConcepts LearningCourseConcept[]
  blankAttempts          BlankAttempt[]
  reviewSchedules        ReviewSchedule[]

  @@index([subjectId])
  @@index([subjectId, sortOrder])
  @@index([conceptCode])
}

model BlankExercise {
  id           String   @id @default(cuid())
  conceptId    String
  level        Int      // 1=easy, 2=hard
  blanks       Json     // [{position, answer, hint}]
  templateText String   @db.Text
  createdAt    DateTime @default(now())

  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([conceptId, level])
}

// FEAT-1: Learning Progress
enum Stage {
  READING
  BLANK_EASY
  BLANK_HARD
  BLANK_FULL
  BLANK_PAGE
}

model LearningProgress {
  id          String    @id @default(cuid())
  userId      String
  conceptId   String
  stage       Stage
  completed   Boolean   @default(false)
  attempts    Int       @default(0)
  score         Int?
  hintCount     Int       @default(0)
  revealCount   Int       @default(0)
  usedReveal    Boolean   @default(false)
  submittedText String?   @db.Text
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId, stage])
  @@index([userId, conceptId])
  @@index([userId, stage])
  @@index([userId, completed])
}

// FEAT: 빈칸 학습 시도 이력 (개별 답변 저장)
model BlankAttempt {
  id          String    @id @default(cuid())
  studentId   String
  conceptId   String
  stage       Stage     // READING, BLANK_EASY, BLANK_HARD, BLANK_FULL, BLANK_PAGE
  score       Int       @default(0) // 정답률 %
  allCorrect  Boolean   @default(false)
  hintCount   Int       @default(0)
  revealCount Int       @default(0)
  createdAt   DateTime  @default(now())

  student User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  concept Concept         @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  answers BlankAnswerLog[]

  @@index([studentId, conceptId, stage])
  @@index([studentId, createdAt(sort: Desc)])
}

model BlankAnswerLog {
  id              String  @id @default(cuid())
  attemptId       String
  blankPosition   Int     // 빈칸 번호 (1, 2, 3...)
  submittedAnswer String  @db.Text
  correctAnswer   String  @db.Text
  isCorrect       Boolean

  attempt BlankAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

// FEAT-1: Gamification
enum PointTransactionType {
  EARN
  SPEND
}

model PointTransaction {
  id          String               @id @default(cuid())
  userId      String
  amount      Int
  type        PointTransactionType
  reason      String               @db.VarChar(50)
  referenceId String?
  createdAt   DateTime             @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
}

// FEAT: XP 상점
enum ShopItemCategory {
  FRAME        // 아바타 테두리
  BACKGROUND   // 프로필 카드 배경
  TITLE        // 칭호
  NAME_COLOR   // 닉네임 색상
  AVATAR       // 아바타 포즈
  EFFECT       // 아바타 이펙트 (CSS 애니메이션)
  HAT          // 모자 악세사리
  GLASSES      // 안경 악세사리
}

model ShopItem {
  id          String           @id @default(cuid())
  category    ShopItemCategory
  name        String           @db.VarChar(50)
  description String?          @db.VarChar(200)
  price       Int
  value       Json             // 인라인 스타일 객체
  preview     String?          @db.VarChar(500)
  sortOrder   Int              @default(0)
  isActive    Boolean          @default(true)
  levelReq    Int              @default(1)
  createdAt   DateTime         @default(now())

  inventories UserInventory[]

  @@index([category, isActive])
}

model UserInventory {
  id          String   @id @default(cuid())
  userId      String
  itemId      String
  purchasedAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  item ShopItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

model StudentProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  totalXp         Int       @default(0)
  level           Int       @default(1)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastActiveAt    DateTime?
  notifCheckedAt  DateTime? // 과제 알림 마지막 확인 시점
  conceptNavMode  String    @default("curriculum") // curriculum | chain:<체인명>
  blankInputMode  String?  // null=반 설정 따름, 'chip' | 'typing'
  representativeBadgeId String?
  spentXp        Int       @default(0)
  equippedItems  Json?
  // 학생 자습 엔진 대개조 — 신규 필드
  streakFreezeCount    Int       @default(0)  // 보유한 스트릭 프리즈 수
  streakFreezeUsedAt   DateTime? // 마지막 프리즈 사용 시점
  homeworkStreak       Int       @default(0)  // 숙제 연속 완료 일수
  homeworkLastDate     DateTime? // 숙제 마지막 완료일 (동일 날짜 중복 방지)
  everRankedFirstAt    DateTime? // 지점 랭킹 1위를 최초 달성한 시점
  badgeShards          Int       @default(0)  // 가차 보상: 뱃지 샤드
  updatedAt       DateTime  @updatedAt

  user                User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  representativeBadge Badge? @relation(fields: [representativeBadgeId], references: [id], onDelete: SetNull)

  @@index([totalXp(sort: Desc), level(sort: Desc)])
}

// FEAT-2: Question Bank
enum QuestionDifficulty {
  BASIC   // 하
  MEDIUM  // 중
  HIGH    // 상
  HIGHEST // 최상
}

enum QuestionType {
  MULTIPLE_CHOICE // 객관식
  SHORT_ANSWER    // 단답형
  ESSAY           // 서술형
}

model Question {
  id          String             @id @default(cuid())
  bookCode    String             @db.VarChar(10)   // "1-1" ~ "3-2"
  chapter     String             @db.VarChar(200)  // 대단원
  section     String?            @db.VarChar(200)  // 중단원/코너
  questionNum Int                                  // 문제 번호
  pageNum     Int?                                 // PDF 페이지

  difficulty  QuestionDifficulty
  type        QuestionType
  content     String             @db.Text
  choices     Json?                                // ["①...", "②...", ...]
  answer      String             @db.Text
  explanation     String?            @db.Text
  scoringCriteria String?            @db.Text          // 채점 요소 (해설에서 분리)
  source      String?            @db.VarChar(200)  // 교재 출처 (예: "RPM 중1-1")
  sourceTag   String?            @db.VarChar(100)  // "핵심문제 익히기" 등
  diagramSpec    Json?                                // 구조화된 도형 명세 (다형성 JSON)
  diagramSVG     String?            @db.Text          // 레거시 raw SVG (하위 호환)
  choiceColumns  Int?                                 // 보기 열 수: null=자동, 1=1열, 2=2열

  // 영역 분류 & 계통도 연결
  domain         String?         @db.VarChar(30)   // 5대 교육과정 영역: number | algebra | function | geometry | statistics
  abilityDomain  String?         @db.VarChar(30)   // 4대 능력 영역: CALCULATION | UNDERSTANDING | PROBLEM_SOLVING | REASONING
  conceptId      String?                           // 연결된 개념 (계통도 분석용)

  // 지점/생성자 메타데이터
  tenantId    String?                              // 생성 지점 (null=공용/레거시)
  createdById String?                              // 생성한 선생님
  examPaperId String?                              // 기출 시험지 출처 (배치 추출)

  // 드래프트(임시 저장) — PDF 추출 중 크래시 대비
  isDraft      Boolean @default(false)
  draftBatchId String? @db.VarChar(40)             // 클라이언트 생성 UUID (추출 세션 단위)
  draftOwnerId String?                              // 드래프트 소유 선생님

  // 동형 변형(숫자만 다른 같은 유형) — 원본↔변형 연결
  variantOfId    String?                            // 원본 문제 ID (변형이면 채워짐, 원본이면 null)
  variantSeed    Int?                                // 같은 원본의 N번째 변형 (1, 2, 3, ...)
  variantSource  String?  @db.VarChar(20)           // 'ai' | 'rule' | 'manual' (생성 방법)

  concept        Concept?           @relation(fields: [conceptId], references: [id], onDelete: SetNull)
  tenant         Tenant?            @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdBy      User?              @relation("createdQuestions", fields: [createdById], references: [id], onDelete: SetNull)
  examPaper      ExamPaper?         @relation("ExamPaperQuestions", fields: [examPaperId], references: [id], onDelete: SetNull)
  variantOf      Question?          @relation("QuestionVariants", fields: [variantOfId], references: [id], onDelete: Cascade)
  variants       Question[]         @relation("QuestionVariants")
  dailyQuestions DailyQuestion[]
  reviewSchedules ReviewSchedule[]

  // 중간테이블 역방향 관계
  testQuestions         TestQuestion[]
  quizSessionQuestions  QuizSessionQuestion[]
  homeworkQuestions     HomeworkQuestion[]

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([bookCode])
  @@index([bookCode, chapter])
  @@index([difficulty])
  @@index([type])
  @@index([domain])
  @@index([conceptId])
  @@index([examPaperId])
  @@index([isDraft, draftOwnerId])
  @@index([draftBatchId])
  @@index([variantOfId])
  @@unique([variantOfId, variantSeed])
  @@index([tenantId])
  @@index([createdById])
}

// Concept Prerequisites (self-referencing many-to-many)
model ConceptPrerequisite {
  id              String  @id @default(cuid())
  conceptId       String
  prerequisiteId  String

  concept       Concept @relation("HasPrerequisite", fields: [conceptId], references: [id], onDelete: Cascade)
  prerequisite  Concept @relation("PrerequisiteFor", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([conceptId, prerequisiteId])
  @@index([conceptId])
  @@index([prerequisiteId])
}

// FEAT-3: Test System
model Test {
  id                  String   @id @default(cuid())
  seq                 Int      @unique @default(autoincrement())
  title               String   @db.VarChar(200)
  description         String?  @db.Text
  grade               Int
  testType            String   @db.VarChar(30)  // concept, cumulative, chapter_final
  questionIds         Json                       // String[] - Question ID 배열
  questionCount       Int
  timeLimitMin        Int?                       // 제한 시간 (분)
  shuffleOptions      Boolean  @default(false)
  isActive            Boolean  @default(true)
  maxAttempts         Int?                       // null=무제한, 1=재시험불가
  defaultDueDate      DateTime?                  // 배정 시 기본 마감일
  allowLateSubmission Boolean  @default(false)   // 기한 후 지각 제출 허용
  createdBy           String
  tenantId            String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenant          Tenant?           @relation(fields: [tenantId], references: [id])
  creator         User              @relation("TestCreator", fields: [createdBy], references: [id])
  attempts        TestAttempt[]
  assignments     TestAssignment[]
  levelTestConfig LevelTestConfig?
  testQuestions   TestQuestion[]

  @@index([grade])
  @@index([createdBy])
  @@index([isActive])
  @@index([tenantId])
}

model TestAttempt {
  id             String    @id @default(cuid())
  testId         String
  studentId      String
  attemptNumber  Int       @default(1)
  assignmentId   String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  score          Int       @default(0)
  maxScore       Int       @default(0)
  correctCount   Int       @default(0)
  totalCount     Int       @default(0)
  xpEarned       Int       @default(0)
  comboMax       Int       @default(0)
  questionOrder  Json?                                          // 셔플된 문제 순서 (string[])
  entryMethod    String    @default("online") @db.VarChar(20)
  enteredBy      String?
  createdAt      DateTime  @default(now())

  test       Test              @relation(fields: [testId], references: [id], onDelete: Cascade)
  student    User              @relation("StudentAttempts", fields: [studentId], references: [id], onDelete: Cascade)
  assignment TestAssignment?   @relation(fields: [assignmentId], references: [id])
  answers    AnswerLog[]

  @@index([studentId])
  @@index([testId])
  @@index([studentId, completedAt])
  @@index([assignmentId])
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

model TestAssignment {
  id                  String           @id @default(cuid())
  seq                 Int              @unique @default(autoincrement())
  testId              String
  studentId           String
  assignedAt          DateTime         @default(now())
  dueDate             DateTime?
  allowLateSubmission Boolean          @default(false)
  status              AssignmentStatus @default(ASSIGNED)
  bestScore           Int?
  bestAttemptId       String?
  updatedAt           DateTime         @updatedAt

  test     Test          @relation(fields: [testId], references: [id], onDelete: Cascade)
  student  User          @relation("StudentAssignments", fields: [studentId], references: [id], onDelete: Cascade)
  attempts TestAttempt[]

  @@unique([testId, studentId])
  @@index([studentId])
  @@index([testId])
  @@index([studentId, status])
}

model AnswerLog {
  id               String   @id @default(cuid())
  attemptId        String
  questionId       String
  selectedAnswer   String   @db.Text
  isCorrect        Boolean
  timeSpentSeconds Int
  comboCount       Int      @default(0)
  pointsEarned     Int      @default(0)
  statusClassification String?  @db.VarChar(20)
  flagged          Boolean  @default(false)
  flagReason       String?  @db.VarChar(100)
  hintUsed         Boolean  @default(false)
  // 1차 오답 기록 (null이면 1차 정답이었음)
  firstSelectedAnswer   String?  @db.Text
  firstTimeSpentSeconds Int?
  createdAt        DateTime @default(now())

  attempt  TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

// FEAT: Support Inquiry System
enum InquiryStatus {
  PENDING
  ANSWERED
}

model Inquiry {
  id         String        @id @default(cuid())
  userId     String
  title      String        @db.VarChar(200)
  category   String        @db.VarChar(50)
  content    String        @db.Text
  status     InquiryStatus @default(PENDING)
  reply      String?       @db.Text
  repliedAt  DateTime?
  repliedBy  String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  user       User          @relation("InquiryAuthor", fields: [userId], references: [id])
  replier    User?         @relation("InquiryReplier", fields: [repliedBy], references: [id])

  @@index([userId])
  @@index([status])
}

// FEAT: Diagnostic Test Results
model DiagnosticResult {
  id              String   @id @default(cuid())
  attemptId       String   @unique
  studentId       String
