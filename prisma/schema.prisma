generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AnswerLog {
  id                    String      @id
  attemptId             String
  questionId            String
  selectedAnswer        String
  isCorrect             Boolean
  timeSpentSeconds      Int
  comboCount            Int         @default(0)
  pointsEarned          Int         @default(0)
  createdAt             DateTime    @default(now())
  flagReason            String?     @db.VarChar(100)
  flagged               Boolean     @default(false)
  statusClassification  String?     @db.VarChar(20)
  hintUsed              Boolean     @default(false)
  firstSelectedAnswer   String?
  firstTimeSpentSeconds Int?
  TestAttempt           TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model ArithmeticAnswer {
  id                String            @id
  attemptId         String
  problemIndex      Int
  content           String
  choices           Json
  selectedAnswer    String
  correctAnswer     String
  isCorrect         Boolean
  timeSpentSeconds  Int               @default(0)
  comboCount        Int               @default(0)
  pointsEarned      Int               @default(0)
  createdAt         DateTime          @default(now())
  ArithmeticAttempt ArithmeticAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model ArithmeticAttempt {
  id                     String                  @id
  studentId              String
  category               String                  @db.VarChar(30)
  level                  String                  @db.VarChar(10)
  problemCount           Int
  correctCount           Int                     @default(0)
  score                  Int                     @default(0)
  xpEarned               Int                     @default(0)
  comboMax               Int                     @default(0)
  totalTimeSeconds       Int                     @default(0)
  completedAt            DateTime?
  createdAt              DateTime                @default(now())
  homeworkDayIndex       Int?
  homeworkPlanId         String?
  ArithmeticAnswer       ArithmeticAnswer[]
  ArithmeticHomeworkPlan ArithmeticHomeworkPlan? @relation(fields: [homeworkPlanId], references: [id])
  User                   User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([homeworkPlanId, homeworkDayIndex])
  @@index([studentId, createdAt(sort: Desc)])
  @@index([studentId, homeworkPlanId])
  @@index([studentId])
}

model ArithmeticHomeworkEnrollment {
  id                     String                 @id
  planId                 String
  studentId              String
  enrolledAt             DateTime               @default(now())
  ArithmeticHomeworkPlan ArithmeticHomeworkPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  User                   User                   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([planId, studentId])
  @@index([planId])
  @@index([studentId])
}

model ArithmeticHomeworkPlan {
  id                           String                         @id
  title                        String                         @db.VarChar(200)
  createdBy                    String
  categories                   Json
  level                        String                         @db.VarChar(10)
  dailyCount                   Int
  totalDays                    Int
  startDate                    DateTime                       @db.Date
  dailyProblems                Json
  isActive                     Boolean                        @default(true)
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime
  progressionMode              String                         @default("sequential") @db.VarChar(20)
  weekdayMap                   Json?
  passingScore                 Int                            @default(80)
  retryOnFail                  Boolean                        @default(false)
  maxRetries                   Int                            @default(3)
  retryMode                    String                         @default("wrong_same") @db.VarChar(20)
  seq                          Int                            @unique @default(autoincrement())
  tenantId                     String?
  ArithmeticAttempt            ArithmeticAttempt[]
  ArithmeticHomeworkEnrollment ArithmeticHomeworkEnrollment[]
  User                         User                           @relation(fields: [createdBy], references: [id])
  Tenant                       Tenant?                        @relation(fields: [tenantId], references: [id])

  @@index([createdBy])
  @@index([isActive])
  @@index([startDate])
  @@index([tenantId])
}

model Badge {
  id          String      @id
  key         String      @unique @db.VarChar(50)
  label       String      @db.VarChar(50)
  description String      @db.VarChar(200)
  icon        String      @db.VarChar(30)
  color       String      @db.VarChar(20)
  condition   Json
  sortOrder   Int         @default(0)
  UserBadge   UserBadge[]
}

model BlankAnswerLog {
  id              String       @id
  attemptId       String
  blankPosition   Int
  submittedAnswer String
  correctAnswer   String
  isCorrect       Boolean
  BlankAttempt    BlankAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
}

model BlankAttempt {
  id             String           @id
  studentId      String
  conceptId      String
  stage          Stage
  score          Int              @default(0)
  allCorrect     Boolean          @default(false)
  hintCount      Int              @default(0)
  revealCount    Int              @default(0)
  createdAt      DateTime         @default(now())
  BlankAnswerLog BlankAnswerLog[]
  Concept        Concept          @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  User           User             @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, conceptId, stage])
  @@index([studentId, createdAt(sort: Desc)])
}

model BlankExercise {
  id           String   @id
  conceptId    String
  level        Int
  blanks       Json
  templateText String
  createdAt    DateTime @default(now())
  Concept      Concept  @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@index([conceptId, level])
}

model Classroom {
  id        String   @id
  name      String   @db.VarChar(50)
  grade     Int?
  teacherId String?
  createdAt DateTime @default(now())
  tenantId  String?
  Tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  User      User[]

  @@index([teacherId])
  @@index([tenantId])
}

model Concept {
  id                                                              String                  @id
  subjectId                                                       String
  title                                                           String                  @db.VarChar(200)
  fullContent                                                     String
  visualAssets                                                    Json?
  sortOrder                                                       Int                     @default(0)
  createdAt                                                       DateTime                @default(now())
  updatedAt                                                       DateTime
  category                                                        String?                 @db.VarChar(20)
  conceptCode                                                     String?                 @unique @db.VarChar(20)
  grade                                                           String?                 @db.VarChar(20)
  keywords                                                        String?
  part                                                            String?                 @db.VarChar(20)
  chapter                                                         String?                 @db.VarChar(100)
  section                                                         String?                 @db.VarChar(100)
  sectionSub                                                      String?                 @db.VarChar(100)
  semester                                                        Int?
  source                                                          String?                 @db.VarChar(200)
  BlankAttempt                                                    BlankAttempt[]
  BlankExercise                                                   BlankExercise[]
  Subject                                                         Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  ConceptPrerequisite_ConceptPrerequisite_conceptIdToConcept      ConceptPrerequisite[]   @relation("ConceptPrerequisite_conceptIdToConcept")
  ConceptPrerequisite_ConceptPrerequisite_prerequisiteIdToConcept ConceptPrerequisite[]   @relation("ConceptPrerequisite_prerequisiteIdToConcept")
  LearningCourseConcept                                           LearningCourseConcept[]
  LearningProgress                                                LearningProgress[]
  Question                                                        Question[]

  @@index([conceptCode])
  @@index([subjectId])
  @@index([subjectId, sortOrder])
}

model ConceptHomeworkEnrollment {
  id                  String              @id
  planId              String
  studentId           String
  enrolledAt          DateTime            @default(now())
  ConceptHomeworkPlan ConceptHomeworkPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  User                User                @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([planId, studentId])
  @@index([planId])
  @@index([studentId])
}

model ConceptHomeworkPlan {
  id                        String                      @id
  seq                       Int                         @unique @default(autoincrement())
  title                     String                      @db.VarChar(200)
  createdBy                 String
  startDate                 DateTime                    @db.Date
  totalDays                 Int
  dailyConcepts             Json
  requiredStage             Stage                       @default(BLANK_FULL)
  isActive                  Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime
  tenantId                  String?
  ConceptHomeworkEnrollment ConceptHomeworkEnrollment[]
  User                      User                        @relation(fields: [createdBy], references: [id])
  Tenant                    Tenant?                     @relation(fields: [tenantId], references: [id])

  @@index([createdBy])
  @@index([isActive])
  @@index([startDate])
  @@index([tenantId])
}

model ConceptMemo {
  id        String   @id
  userId    String
  conceptId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId])
  @@index([userId])
}

model ConceptPrerequisite {
  id                                                  String  @id
  conceptId                                           String
  prerequisiteId                                      String
  Concept_ConceptPrerequisite_conceptIdToConcept      Concept @relation("ConceptPrerequisite_conceptIdToConcept", fields: [conceptId], references: [id], onDelete: Cascade)
  Concept_ConceptPrerequisite_prerequisiteIdToConcept Concept @relation("ConceptPrerequisite_prerequisiteIdToConcept", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  @@unique([conceptId, prerequisiteId])
  @@index([conceptId])
  @@index([prerequisiteId])
}

model DailyMission {
  id          String   @id
  studentId   String
  date        DateTime @db.Date
  missions    Json
  allComplete Boolean  @default(false)
  xpAwarded   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  User        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([studentId, date])
}

model DailyQuestion {
  id                   String                 @id
  questionId           String
  date                 DateTime               @db.Date
  createdBy            String?
  createdAt            DateTime               @default(now())
  tenantId             String?
  Question             Question               @relation(fields: [questionId], references: [id])
  Tenant               Tenant?                @relation(fields: [tenantId], references: [id])
  DailyQuestionAttempt DailyQuestionAttempt[]

  @@unique([date, tenantId])
  @@index([date])
  @@index([tenantId])
}

model DailyQuestionAttempt {
  id              String        @id
  dailyQuestionId String
  studentId       String
  selectedAnswer  String
  isCorrect       Boolean
  createdAt       DateTime      @default(now())
  DailyQuestion   DailyQuestion @relation(fields: [dailyQuestionId], references: [id], onDelete: Cascade)
  User            User          @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([dailyQuestionId, studentId])
  @@index([studentId])
}

model DiagnosticResult {
  id              String   @id
  attemptId       String   @unique
  studentId       String
  diagnosticType  String   @db.VarChar(20)
  recommendLevel  String   @db.VarChar(20)
  weakAreas       Json
  strongAreas     Json
  overallAccuracy Int
  createdAt       DateTime @default(now())
  domainScores    Json?

  @@index([studentId, diagnosticType])
  @@index([studentId])
}

model FeatureFlag {
  id        String   @id
  key       String   @db.VarChar(50)
  enabled   Boolean  @default(true)
  label     String   @db.VarChar(100)
  updatedAt DateTime
  tenantId  String?
  Tenant    Tenant?  @relation(fields: [tenantId], references: [id])

  @@unique([key, tenantId])
  @@index([tenantId])
}

model HomeworkQuestion {
  id                   String               @id
  planId               String
  questionId           String
  dayIndex             Int
  sortOrder            Int
  QuestionHomeworkPlan QuestionHomeworkPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  Question             Question             @relation(fields: [questionId], references: [id])

  @@index([planId, dayIndex, sortOrder])
  @@index([questionId])
}

model Inquiry {
  id                           String        @id
  userId                       String
  title                        String        @db.VarChar(200)
  category                     String        @db.VarChar(50)
  content                      String
  status                       InquiryStatus @default(PENDING)
  reply                        String?
  repliedAt                    DateTime?
  repliedBy                    String?
  createdAt                    DateTime      @default(now())
  updatedAt                    DateTime
  User_Inquiry_repliedByToUser User?         @relation("Inquiry_repliedByToUser", fields: [repliedBy], references: [id])
  User_Inquiry_userIdToUser    User          @relation("Inquiry_userIdToUser", fields: [userId], references: [id])

  @@index([status])
  @@index([userId])
}

model LearningCourse {
  id                       String                     @id
  seq                      Int                        @unique @default(autoincrement())
  title                    String                     @db.VarChar(200)
  description              String?
  createdBy                String
  isActive                 Boolean                    @default(true)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime
  tenantId                 String?
  User                     User                       @relation(fields: [createdBy], references: [id])
  Tenant                   Tenant?                    @relation(fields: [tenantId], references: [id])
  LearningCourseConcept    LearningCourseConcept[]
  LearningCourseEnrollment LearningCourseEnrollment[]

  @@index([createdBy])
  @@index([isActive])
  @@index([tenantId])
}

model LearningCourseConcept {
  id             String         @id
  courseId       String
  conceptId      String
  sortOrder      Int            @default(0)
  Concept        Concept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  LearningCourse LearningCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, conceptId])
  @@index([courseId, sortOrder])
}

model LearningCourseEnrollment {
  id             String         @id
  courseId       String
  studentId      String
  sortOrder      Int            @default(0)
  status         CourseStatus   @default(LOCKED)
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  LearningCourse LearningCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  User           User           @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId, sortOrder])
  @@index([studentId, status])
}

model LearningProgress {
  id            String    @id
  userId        String
  conceptId     String
  stage         Stage
  completed     Boolean   @default(false)
  attempts      Int       @default(0)
  score         Int?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime
  submittedText String?
  hintCount     Int       @default(0)
  revealCount   Int       @default(0)
  usedReveal    Boolean   @default(false)
  Concept       Concept   @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  User          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conceptId, stage])
  @@index([userId, completed])
  @@index([userId, conceptId])
  @@index([userId, stage])
}

model LevelTestConfig {
  id               String  @id
  testId           String  @unique
  questionDomains  Json
  questionsPerPage Int?
  spacing          String? @db.VarChar(10)
  Test             Test    @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
}

model Parent {
  id        String   @id
  studentId String
  name      String   @db.VarChar(50)
  phone     String   @db.VarChar(20)
  createdAt DateTime @default(now())

  @@index([studentId])
}

model PointTransaction {
  id          String               @id
  userId      String
  amount      Int
  type        PointTransactionType
  reason      String               @db.VarChar(50)
  referenceId String?
  createdAt   DateTime             @default(now())
  User        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId])
}

model Question {
  id                  String                @id
  bookCode            String                @db.VarChar(10)
  chapter             String                @db.VarChar(200)
  section             String?               @db.VarChar(200)
  questionNum         Int
  pageNum             Int?
  difficulty          QuestionDifficulty
  type                QuestionType
  content             String
  choices             Json?
  answer              String
  explanation         String?
  sourceTag           String?               @db.VarChar(100)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  conceptId           String?
  domain              String?               @db.VarChar(30)
  diagramSVG          String?
  diagramSpec         Json?
  DailyQuestion       DailyQuestion[]
  HomeworkQuestion    HomeworkQuestion[]
  Concept             Concept?              @relation(fields: [conceptId], references: [id])
  QuizSessionQuestion QuizSessionQuestion[]
  TestQuestion        TestQuestion[]

  @@index([bookCode, chapter])
  @@index([bookCode])
  @@index([conceptId])
  @@index([difficulty])
  @@index([domain])
  @@index([type])
}

model QuestionGenerationLog {
  id           String   @id
  teacherId    String
  mode         String   @db.VarChar(20)
  schoolLevel  String?  @db.VarChar(20)
  grade        String?  @db.VarChar(20)
  mainUnit     String?  @db.VarChar(200)
  subUnit      String?  @db.VarChar(200)
  detailUnit   String?  @db.VarChar(200)
  difficulty   String?  @db.VarChar(20)
  problemType  String?  @db.VarChar(20)
  questionId   String?
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, createdAt(sort: Desc)])
  @@index([teacherId])
}

model QuestionHomeworkAttempt {
  id                   String               @id
  planId               String
  studentId            String
  dayIndex             Int
  answers              Json
  correctCount         Int                  @default(0)
  totalCount           Int                  @default(0)
  score                Int                  @default(0)
  completedAt          DateTime?
  createdAt            DateTime             @default(now())
  QuestionHomeworkPlan QuestionHomeworkPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  User                 User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([planId, studentId, dayIndex])
  @@index([studentId])
}

model QuestionHomeworkEnrollment {
  id                   String               @id
  planId               String
  studentId            String
  enrolledAt           DateTime             @default(now())
  QuestionHomeworkPlan QuestionHomeworkPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  User                 User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([planId, studentId])
  @@index([planId])
  @@index([studentId])
}

model QuestionHomeworkPlan {
  id                         String                       @id
  seq                        Int                          @unique @default(autoincrement())
  title                      String                       @db.VarChar(200)
  createdBy                  String
  startDate                  DateTime                     @db.Date
  totalDays                  Int
  dailyQuestions             Json
  passingScore               Int                          @default(80)
  isActive                   Boolean                      @default(true)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime
  tenantId                   String?
  HomeworkQuestion           HomeworkQuestion[]
  QuestionHomeworkAttempt    QuestionHomeworkAttempt[]
  QuestionHomeworkEnrollment QuestionHomeworkEnrollment[]
  User                       User                         @relation(fields: [createdBy], references: [id])
  Tenant                     Tenant?                      @relation(fields: [tenantId], references: [id])

  @@index([createdBy])
  @@index([isActive])
  @@index([startDate])
  @@index([tenantId])
}

model QuizAnswerLog {
  id               String          @id
  participantId    String
  questionId       String
  questionIndex    Int
  selectedAnswer   String
  correctAnswer    String
  isCorrect        Boolean
  timeSpentSeconds Int             @default(0)
  pointsEarned     Int             @default(0)
  createdAt        DateTime        @default(now())
  QuizParticipant  QuizParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, questionId])
  @@index([participantId])
}

model QuizParticipant {
  id            String          @id
  sessionId     String
  studentId     String
  studentName   String          @db.VarChar(50)
  score         Int             @default(0)
  correctCount  Int             @default(0)
  rank          Int?
  QuizAnswerLog QuizAnswerLog[]
  QuizSession   QuizSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, studentId])
  @@index([sessionId])
}

model QuizSession {
  id                  String                @id
  title               String                @db.VarChar(200)
  hostId              String
  questionIds         Json
  status              QuizStatus            @default(WAITING)
  currentQ            Int                   @default(0)
  joinCode            String                @unique @db.VarChar(6)
  startedAt           DateTime?
  endedAt             DateTime?
  createdAt           DateTime              @default(now())
  questionChangedAt   DateTime?
  tenantId            String?
  QuizParticipant     QuizParticipant[]
  Tenant              Tenant?               @relation(fields: [tenantId], references: [id])
  QuizSessionQuestion QuizSessionQuestion[]

  @@index([hostId])
  @@index([joinCode])
  @@index([status])
  @@index([tenantId])
}

model QuizSessionQuestion {
  id          String      @id
  sessionId   String
  questionId  String
  sortOrder   Int
  Question    Question    @relation(fields: [questionId], references: [id])
  QuizSession QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([questionId])
  @@index([sessionId, sortOrder])
}

model ReportHistory {
  id        String   @id
  studentId String
  type      String   @db.VarChar(30)
  content   Json
  sentAt    DateTime @default(now())
  channel   String   @db.VarChar(20)

  @@index([studentId])
  @@index([studentId, type])
}

model School {
  id         String   @id
  name       String   @unique @db.VarChar(100)
  city       String   @db.VarChar(50)
  district   String   @db.VarChar(50)
  schoolType String   @db.VarChar(20)
  createdAt  DateTime @default(now())

  @@index([city, district])
  @@index([schoolType])
}

model Session {
  id           String   @id
  userId       String
  sessionToken String   @unique
  expires      DateTime
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StudentProfile {
  id             String    @id
  userId         String    @unique
  totalXp        Int       @default(0)
  level          Int       @default(1)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  lastActiveAt   DateTime?
  updatedAt      DateTime
  conceptNavMode String    @default("curriculum")
  notifCheckedAt DateTime?
  User           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalXp(sort: Desc), level(sort: Desc)])
}

model Subject {
  id          String    @id
  title       String    @db.VarChar(200)
  description String?
  gradeLevel  Int
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  Concept     Concept[]

  @@index([gradeLevel])
  @@index([sortOrder])
}

model TeacherComment {
  id                                  String   @id
  teacherId                           String
  studentId                           String
  month                               String   @db.VarChar(7)
  content                             String
  createdAt                           DateTime @default(now())
  updatedAt                           DateTime
  User_TeacherComment_studentIdToUser User     @relation("TeacherComment_studentIdToUser", fields: [studentId], references: [id], onDelete: Cascade)
  User_TeacherComment_teacherIdToUser User     @relation("TeacherComment_teacherIdToUser", fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId, month])
  @@index([studentId])
  @@index([teacherId])
}

model Tenant {
  id                     String                   @id
  slug                   String                   @unique @db.VarChar(50)
  name                   String                   @db.VarChar(100)
  logo                   String?                  @db.VarChar(500)
  settings               Json?
  isActive               Boolean                  @default(true)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime
  ArithmeticHomeworkPlan ArithmeticHomeworkPlan[]
  Classroom              Classroom[]
  ConceptHomeworkPlan    ConceptHomeworkPlan[]
  DailyQuestion          DailyQuestion[]
  FeatureFlag            FeatureFlag[]
  LearningCourse         LearningCourse[]
  QuestionHomeworkPlan   QuestionHomeworkPlan[]
  QuizSession            QuizSession[]
  Test                   Test[]
  User                   User[]

  @@index([isActive])
  @@index([slug])
}

model Test {
  id                  String           @id
  title               String           @db.VarChar(200)
  description         String?
  grade               Int
  testType            String           @db.VarChar(30)
  questionIds         Json
  questionCount       Int
  timeLimitMin        Int?
  shuffleOptions      Boolean          @default(false)
  isActive            Boolean          @default(true)
  createdBy           String
  createdAt           DateTime         @default(now())
  updatedAt           DateTime
  allowLateSubmission Boolean          @default(false)
  defaultDueDate      DateTime?
  maxAttempts         Int?
  seq                 Int              @unique @default(autoincrement())
  tenantId            String?
  LevelTestConfig     LevelTestConfig?
  User                User             @relation(fields: [createdBy], references: [id])
  Tenant              Tenant?          @relation(fields: [tenantId], references: [id])
  TestAssignment      TestAssignment[]
  TestAttempt         TestAttempt[]
  TestQuestion        TestQuestion[]

  @@index([createdBy])
  @@index([grade])
  @@index([isActive])
  @@index([tenantId])
}

model TestAssignment {
  id                  String           @id
  testId              String
  studentId           String
  assignedAt          DateTime         @default(now())
  dueDate             DateTime?
  allowLateSubmission Boolean          @default(false)
  status              AssignmentStatus @default(ASSIGNED)
  bestScore           Int?
  bestAttemptId       String?
  updatedAt           DateTime
  seq                 Int              @unique @default(autoincrement())
  User                User             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Test                Test             @relation(fields: [testId], references: [id], onDelete: Cascade)
  TestAttempt         TestAttempt[]

  @@unique([testId, studentId])
  @@index([studentId])
  @@index([studentId, status])
  @@index([testId])
}

model TestAttempt {
  id             String          @id
  testId         String
  studentId      String
  startedAt      DateTime        @default(now())
  completedAt    DateTime?
  score          Int             @default(0)
  maxScore       Int             @default(0)
  correctCount   Int             @default(0)
  totalCount     Int             @default(0)
  xpEarned       Int             @default(0)
  comboMax       Int             @default(0)
  createdAt      DateTime        @default(now())
  assignmentId   String?
  attemptNumber  Int             @default(1)
  enteredBy      String?
  entryMethod    String          @default("online") @db.VarChar(20)
  AnswerLog      AnswerLog[]
  TestAssignment TestAssignment? @relation(fields: [assignmentId], references: [id])
  User           User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  Test           Test            @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([assignmentId])
  @@index([studentId, completedAt])
  @@index([studentId])
  @@index([testId])
}

model TestQuestion {
  id         String   @id
  testId     String
  questionId String
  sortOrder  Int
  Question   Question @relation(fields: [questionId], references: [id])
  Test       Test     @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, questionId])
  @@index([questionId])
  @@index([testId, sortOrder])
}

model TimeAttackRecord {
  id           String   @id
  studentId    String
  category     String   @db.VarChar(30)
  level        String   @db.VarChar(10)
  correctCount Int
  totalTime    Int
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([correctCount(sort: Desc)])
  @@index([studentId, category, level])
}

model User {
  id                                            String                         @id
  username                                      String                         @unique @db.VarChar(50)
  passwordHash                                  String                         @db.VarChar(255)
  name                                          String                         @db.VarChar(50)
  role                                          Role                           @default(STUDENT)
  grade                                         Int?
  profileImage                                  String?                        @db.VarChar(500)
  createdAt                                     DateTime                       @default(now())
  updatedAt                                     DateTime
  deletedAt                                     DateTime?
  seq                                           Int                            @unique @default(autoincrement())
  classroomId                                   String?
  address                                       String?                        @db.VarChar(200)
  birthDate                                     DateTime?
  email                                         String?                        @db.VarChar(100)
  notes                                         String?
  parentName                                    String?                        @db.VarChar(50)
  parentPhone                                   String?                        @db.VarChar(20)
  phone                                         String?                        @db.VarChar(20)
  school                                        String?                        @db.VarChar(100)
  startDate                                     DateTime?
  tenantId                                      String?
  ArithmeticAttempt                             ArithmeticAttempt[]
  ArithmeticHomeworkEnrollment                  ArithmeticHomeworkEnrollment[]
  ArithmeticHomeworkPlan                        ArithmeticHomeworkPlan[]
  BlankAttempt                                  BlankAttempt[]
  ConceptHomeworkEnrollment                     ConceptHomeworkEnrollment[]
  ConceptHomeworkPlan                           ConceptHomeworkPlan[]
  ConceptMemo                                   ConceptMemo[]
  DailyMission                                  DailyMission[]
  DailyQuestionAttempt                          DailyQuestionAttempt[]
  Inquiry_Inquiry_repliedByToUser               Inquiry[]                      @relation("Inquiry_repliedByToUser")
  Inquiry_Inquiry_userIdToUser                  Inquiry[]                      @relation("Inquiry_userIdToUser")
  LearningCourse                                LearningCourse[]
  LearningCourseEnrollment                      LearningCourseEnrollment[]
  LearningProgress                              LearningProgress[]
  PointTransaction                              PointTransaction[]
  QuestionGenerationLog                         QuestionGenerationLog[]
  QuestionHomeworkAttempt                       QuestionHomeworkAttempt[]
  QuestionHomeworkEnrollment                    QuestionHomeworkEnrollment[]
  QuestionHomeworkPlan                          QuestionHomeworkPlan[]
  Session                                       Session[]
  StudentProfile                                StudentProfile?
  TeacherComment_TeacherComment_studentIdToUser TeacherComment[]               @relation("TeacherComment_studentIdToUser")
  TeacherComment_TeacherComment_teacherIdToUser TeacherComment[]               @relation("TeacherComment_teacherIdToUser")
  Test                                          Test[]
  TestAssignment                                TestAssignment[]
  TestAttempt                                   TestAttempt[]
  TimeAttackRecord                              TimeAttackRecord[]
  Classroom                                     Classroom?                     @relation(fields: [classroomId], references: [id])
  Tenant                                        Tenant?                        @relation(fields: [tenantId], references: [id])
  UserBadge                                     UserBadge[]

  @@index([classroomId])
  @@index([role])
  @@index([tenantId])
  @@index([tenantId, role])
}

model UserBadge {
  id       String   @id
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())
  Badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  User     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

enum AssignmentStatus {
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum CourseStatus {
  LOCKED
  ACTIVE
  COMPLETED
}

enum InquiryStatus {
  PENDING
  ANSWERED
}

enum PointTransactionType {
  EARN
  SPEND
}

enum QuestionDifficulty {
  BASIC
  MEDIUM
  HIGH
  HIGHEST
}

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  ESSAY
}

enum QuizStatus {
  WAITING
  ACTIVE
  COMPLETED
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
  MANAGER
  OWNER
  SUPER_ADMIN
}

enum Stage {
  READING
  BLANK_EASY
  BLANK_HARD
  BLANK_PAGE
  BLANK_FULL
}
