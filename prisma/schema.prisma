// FEAT: Teacher Comment on Student Analytics
model TeacherComment {
  id        String   @id @default(cuid())
  teacherId String
  studentId String
  month     String   @db.VarChar(7)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacher User @relation("TeacherComments", fields: [teacherId], references: [id], onDelete: Cascade)
  student User @relation("StudentComments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([teacherId, studentId, month])
  @@index([teacherId])
  @@index([studentId])
}

// FEAT: AI Question Generation Log
model QuestionGenerationLog {
  id           String   @id @default(cuid())
  teacherId    String
  mode         String   @db.VarChar(20)
  schoolLevel  String?  @db.VarChar(20)
  grade        String?  @db.VarChar(20)
  mainUnit     String?  @db.VarChar(200)
  subUnit      String?  @db.VarChar(200)
  detailUnit   String?  @db.VarChar(200)
  difficulty   String?  @db.VarChar(20)
  problemType  String?  @db.VarChar(20)
  questionId   String?
  success      Boolean
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([teacherId, createdAt(sort: Desc)])
}

// FEAT: Feature Flags (Admin 토글, 테넌트별 오버라이드 지원)
model FeatureFlag {
  id        String   @id @default(cuid())
  key       String   @db.VarChar(50)
  enabled   Boolean  @default(true)
  label     String   @db.VarChar(100)
  tenantId  String?                          // null = 글로벌 기본값, 값 있으면 테넌트 전용
  updatedAt DateTime @updatedAt

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@unique([key, tenantId])  // 테넌트별 키 고유
  @@index([tenantId])
}

// FEAT: 연산 타임어택 최고기록
model TimeAttackRecord {
  id           String   @id @default(cuid())
  studentId    String
  category     String   @db.VarChar(30)
  level        String   @db.VarChar(10)
  correctCount Int
  totalTime    Int      // 제한시간(초), 항상 30
  createdAt    DateTime @default(now())

  student User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers TimeAttackAnswer[]

  @@index([studentId, category, level])
  @@index([correctCount(sort: Desc)])
}

model TimeAttackAnswer {
  id               String           @id @default(cuid())
  recordId         String
  problemIndex     Int
  content          String
  choices          Json
  selectedAnswer   String
  correctAnswer    String
  isCorrect        Boolean
  timeSpentMs      Int              @default(0)
  comboCount       Int              @default(0)
  createdAt        DateTime         @default(now())

  record TimeAttackRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId])
}

model RevengeAttempt {
  id               String          @id @default(cuid())
  studentId        String
  chapter          String          @db.VarChar(200)
  difficulty       String          @db.VarChar(20)
  correctCount     Int             @default(0)
  totalCount       Int             @default(0)
  accuracy         Int             @default(0)
  xpEarned         Int             @default(0)
  isVictory        Boolean         @default(false)
  totalTimeSeconds Int             @default(0)
  completedAt      DateTime        @default(now())
  createdAt        DateTime        @default(now())

  answers RevengeAnswer[]
  student User            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt(sort: Desc)])
  @@index([studentId, chapter])
}

model RevengeAnswer {
  id               String         @id @default(cuid())
  attemptId        String
  questionId       String
  problemIndex     Int
  selectedAnswer   String
  correctAnswer    String
  isCorrect        Boolean
  timeSpentSeconds Int            @default(0)
  createdAt        DateTime       @default(now())

  attempt RevengeAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([questionId])
}

// FEAT: 오늘의 한 문제
model DailyQuestion {
  id         String   @id @default(cuid())
  questionId String
  date       DateTime @db.Date
  createdBy  String?
  tenantId   String?
  createdAt  DateTime @default(now())

  tenant   Tenant?              @relation(fields: [tenantId], references: [id])
  question Question            @relation(fields: [questionId], references: [id])
  attempts DailyQuestionAttempt[]

  @@unique([date, tenantId])  // 테넌트별 일일 문제
