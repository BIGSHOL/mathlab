  creator     User                        @relation("ConceptHomeworkPlanCreator", fields: [createdBy], references: [id])
  enrollments ConceptHomeworkEnrollment[]

  @@index([createdBy])
  @@index([isActive])
  @@index([startDate])
  @@index([tenantId])
}

model ConceptHomeworkEnrollment {
  id         String   @id @default(cuid())
  planId     String
  studentId  String
  enrolledAt DateTime @default(now())

  plan    ConceptHomeworkPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  student User               @relation("ConceptHomeworkEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([planId, studentId])
  @@index([studentId])
  @@index([planId])
