// FEAT: 반(교실) 관리
model Classroom {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(50)
  grade     Int?
  teacherId String?
  tenantId  String?
  settings  Json?    // { blankInputMode?: 'chip' | 'typing' }
  createdAt DateTime @default(now())

  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  students User[]

  @@index([teacherId])
  @@index([tenantId])
}

// FEAT: Learning Course Assignment (학습 과정 배정)
enum CourseStatus {
  LOCKED
  ACTIVE
  COMPLETED
}

model LearningCourse {
  id          String   @id @default(cuid())
  seq         Int      @unique @default(autoincrement())
  title       String   @db.VarChar(200)
  description String?  @db.Text
  createdBy   String
  isActive    Boolean  @default(true)
  tenantId    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant?                   @relation(fields: [tenantId], references: [id])
  creator     User                      @relation("LearningCourseCreator", fields: [createdBy], references: [id])
  concepts    LearningCourseConcept[]
  enrollments LearningCourseEnrollment[]

  @@index([createdBy])
  @@index([isActive])
  @@index([tenantId])
}

model LearningCourseConcept {
  id        String @id @default(cuid())
  courseId   String
  conceptId String
  sortOrder Int    @default(0)

  course  LearningCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  concept Concept        @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@unique([courseId, conceptId])
  @@index([courseId, sortOrder])
}

model LearningCourseEnrollment {
  id          String       @id @default(cuid())
  courseId     String
  studentId   String
  sortOrder   Int          @default(0)
  status      CourseStatus @default(LOCKED)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  course  LearningCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student User           @relation("LearningCourseEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([courseId, studentId])
  @@index([studentId, status])
  @@index([studentId, sortOrder])
}

// ── 문제 중간테이블 (questionIds Json → 관계형 전환) ──

model TestQuestion {
  id         String @id @default(cuid())
  testId     String
  questionId String
  sortOrder  Int

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([testId, questionId])
  @@index([testId, sortOrder])
  @@index([questionId])
}

model QuizSessionQuestion {
  id         String @id @default(cuid())
  sessionId  String
  questionId String
  sortOrder  Int

  session  QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, questionId])
  @@index([sessionId, sortOrder])
  @@index([questionId])
}

model HomeworkQuestion {
  id         String @id @default(cuid())
  planId     String
  questionId String
  dayIndex   Int
  sortOrder  Int

  plan     QuestionHomeworkPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  question Question             @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([planId, dayIndex, sortOrder])
  @@index([questionId])
}

// FEAT: 이용권 시스템 — 지점 이용권 풀
model TenantLicense {
  id        String         @id @default(cuid())
  tenantId  String
  feature   LicenseFeature
  maxSeats  Int
  usedSeats Int            @default(0)  // 현재 배정 수 (비정규화, 빠른 조회)
  expiresAt DateTime?                   // null = 무기한
  memo      String?        @db.Text
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  studentLicenses StudentLicense[]

  @@unique([tenantId, feature])  // 지점당 기능별 하나
  @@index([tenantId])
}

// FEAT: 이용권 시스템 — 학생 개별 배정
model StudentLicense {
  id              String         @id @default(cuid())
  studentId       String
  tenantLicenseId String
  feature         LicenseFeature // 비정규화 (빠른 조회)
  expiresAt       DateTime?      // null = TenantLicense 만료일 따름
  assignedBy      String         // 배정한 OWNER의 userId
  assignedAt      DateTime       @default(now())
  revokedAt       DateTime?      // null = 활성 중

  student        User          @relation("StudentLicenses", fields: [studentId], references: [id])
  tenantLicense  TenantLicense @relation(fields: [tenantLicenseId], references: [id])
  assignedByUser User          @relation("LicenseAssignedBy", fields: [assignedBy], references: [id])

  @@index([studentId, feature])
  @@index([tenantLicenseId])
}
