  @@unique([courseId, studentId])
  @@index([studentId, status])
  @@index([studentId, sortOrder])
}

// ── 문제 중간테이블 (questionIds Json → 관계형 전환) ──

model TestQuestion {
  id         String @id @default(cuid())
  testId     String
  questionId String
  sortOrder  Int

  test     Test     @relation(fields: [testId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([testId, questionId])
  @@index([testId, sortOrder])
  @@index([questionId])
}

model QuizSessionQuestion {
  id         String @id @default(cuid())
  sessionId  String
  questionId String
  sortOrder  Int

  session  QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question    @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, questionId])
  @@index([sessionId, sortOrder])
  @@index([questionId])
}

model HomeworkQuestion {
  id         String @id @default(cuid())
  planId     String
  questionId String
  dayIndex   Int
  sortOrder  Int

  plan     QuestionHomeworkPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  question Question             @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@index([planId, dayIndex, sortOrder])
  @@index([questionId])
}

// FEAT: 이용권 시스템 — 지점 이용권 풀
model TenantLicense {
  id        String         @id @default(cuid())
  tenantId  String
  feature   LicenseFeature
  maxSeats  Int
  usedSeats Int            @default(0)  // 현재 배정 수 (비정규화, 빠른 조회)
  expiresAt DateTime?                   // null = 무기한
  memo      String?        @db.Text
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  studentLicenses StudentLicense[]

  @@unique([tenantId, feature])  // 지점당 기능별 하나
  @@index([tenantId])
}

// FEAT: 이용권 시스템 — 학생 개별 배정
model StudentLicense {
  id              String         @id @default(cuid())
  studentId       String
  tenantLicenseId String
  feature         LicenseFeature // 비정규화 (빠른 조회)
  expiresAt       DateTime?      // null = TenantLicense 만료일 따름
  assignedBy      String         // 배정한 OWNER의 userId
  assignedAt      DateTime       @default(now())
  revokedAt       DateTime?      // null = 활성 중

  student        User          @relation("StudentLicenses", fields: [studentId], references: [id])
  tenantLicense  TenantLicense @relation(fields: [tenantLicenseId], references: [id])
  assignedByUser User          @relation("LicenseAssignedBy", fields: [assignedBy], references: [id])

  @@index([studentId, feature])
  @@index([tenantLicenseId])
}

// ══════════════════════════════════════════════════════════════
// FEAT: 기출 분석 (Exam Analysis) — Math Report 이식
// ══════════════════════════════════════════════════════════════

model ExamPaper {
  id            String          @id @default(cuid())
  tenantId      String
  teacherId     String
  studentId     String?
  title         String          @db.VarChar(200)
  subject       ExamSubject     @default(MATH)
  grade         String          @db.VarChar(30)
  category      String?         @db.VarChar(50)
  unit          String?         @db.VarChar(200)
  examScope     Json?
  schoolName    String?         @db.VarChar(100)
  schoolId      String?         @db.VarChar(50)               // FK → School (자동 매칭)
  examType      String          @default("blank") @db.VarChar(20)
  fileUrls      String          @db.Text
  fileType      String          @db.VarChar(20)
  status        ExamPaperStatus @default(PENDING)
  analysisStep  Int             @default(0)   // 0=대기, 1=파일로드, 2=분류, 3=AI분석, 4=저장
  errorMessage  String?         @db.Text
  extractedToBankAt DateTime?                  // 문제은행에 추출된 시각 (내신대비 자동 감지용)
  extractedQuestionCount Int?                  // 추출된 문제 수
  // ── 배치 추출 승인/재시도 메타 ──
  extractApproved     Boolean   @default(false)  // SUPER_ADMIN 승인 여부
  extractApprovedBy   String?                     // 승인자 userId
  extractApprovedAt   DateTime?
  extractAttempts     Int       @default(0)       // 배치 시도 횟수
  lastExtractError    String?   @db.Text          // 최근 추출 실패 사유
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  teacher       User            @relation("ExamPaperTeacher", fields: [teacherId], references: [id])
  student       User?           @relation("ExamPaperStudent", fields: [studentId], references: [id])
  school        School?         @relation(fields: [schoolId], references: [id])
  analyses      ExamAnalysis[]
  extractedQuestions Question[] @relation("ExamPaperQuestions")

  @@index([tenantId])
  @@index([teacherId])
  @@index([tenantId, subject])
  @@index([schoolId])
  @@index([status, extractApproved, extractedToBankAt])
}

// ExamPaper 배치 추출 스케줄
model ExamExtractSchedule {
  id           String   @id @default(cuid())
  tenantId     String?                      // 스케줄 생성 지점 (참고용)
  scheduledAt  DateTime                     // 실행 예정 시각
  status       String   @default("PENDING") @db.VarChar(20)  // PENDING | RUNNING | DONE | FAILED | CANCELLED
  examPaperIds String[]                     // 처리할 시험지 ID 목록
  createdBy    String                       // SUPER_ADMIN userId
  createdAt    DateTime @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  result       Json?                        // { success, failed, skipped, errors: [{id, error}] }

  @@index([status, scheduledAt])
  @@index([createdBy])
}

model ExamAnalysis {
  id              String   @id @default(cuid())
  examPaperId     String
  questions       Json
  summary         Json?
  markDetection   Json?
  crossValidation Json?
  modelVersion    String?  @db.VarChar(50)
  totalQuestions  Int?
  totalPoints     Int?
  earnedPoints    Int?
  analyzedAt      DateTime?
  createdAt       DateTime @default(now())

  examPaper       ExamPaper              @relation(fields: [examPaperId], references: [id], onDelete: Cascade)
  extensions      ExamAnalysisExtension[]

  @@index([examPaperId])
}

model ExamAnalysisExtension {
  id            String   @id @default(cuid())
  analysisId    String
  agentType     String   @db.VarChar(30)
  result        Json
  errorMessage  String?  @db.Text
  createdAt     DateTime @default(now())

  analysis      ExamAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@unique([analysisId, agentType])
  @@index([analysisId])
}

// ── 패턴 시스템 (오답 패턴 DB) ──

model ExamProblemCategory {
  id          String   @id @default(cuid())
  subject     ExamSubject
  name        String   @db.VarChar(100)
  nameEn      String?  @db.VarChar(100)
  description String?  @db.Text
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  parent       ExamProblemCategory?  @relation("ExamCategoryHierarchy", fields: [parentId], references: [id])
  children     ExamProblemCategory[] @relation("ExamCategoryHierarchy")
  problemTypes ExamProblemType[]

  @@index([subject])
  @@index([parentId])
}

model ExamProblemType {
  id          String   @id @default(cuid())
  categoryId  String
  name        String   @db.VarChar(200)
  description String?  @db.Text
  gradelevels Json?
  keywords    Json?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  category      ExamProblemCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  errorPatterns ExamErrorPattern[]

  @@index([categoryId])
}

model ExamErrorPattern {
  id              String      @id @default(cuid())
  problemTypeId   String?
  subject         ExamSubject
  name            String      @db.VarChar(200)
  description     String      @db.Text
  errorType       String      @default("concept") @db.VarChar(30)
  frequency       Int         @default(0)
  severity        Int         @default(1)
  wrongExamples   Json?
  correctExamples Json?
  feedbackMessage String?     @db.Text
  detectionKeywords Json?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  problemType  ExamProblemType?          @relation(fields: [problemTypeId], references: [id], onDelete: SetNull)
  matchHistory ExamPatternMatchHistory[]

  @@index([subject])
  @@index([problemTypeId])
}

model ExamPromptTemplate {
  id          String      @id @default(cuid())
  subject     ExamSubject
  agentType   String      @db.VarChar(30)
  name        String      @db.VarChar(200)
  version     Int         @default(1)
  template    String      @db.Text
  variables   Json?
  isActive    Boolean     @default(true)
  isDefault   Boolean     @default(false)
  createdBy   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([subject, agentType, version])
  @@index([subject, agentType, isActive])
}

model ExamPatternExample {
  id          String      @id @default(cuid())
  patternId   String
  subject     ExamSubject
  input       String      @db.Text
  output      String      @db.Text
  metadata    Json?
  createdAt   DateTime    @default(now())

  @@index([patternId])
  @@index([subject])
}

model ExamPatternMatchHistory {
  id          String   @id @default(cuid())
  patternId   String
  analysisId  String
  questionNum Int
  confidence  Float
  matchedAt   DateTime @default(now())

  pattern     ExamErrorPattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@index([patternId])
  @@index([analysisId])
}

// ── 트렌드 + 참조 문제 ──

model ExamSchoolTrend {
  id             String      @id @default(cuid())
  tenantId       String
  subject        ExamSubject
  grade          String      @db.VarChar(30)
  period         String      @db.VarChar(30)
  schoolName     String?     @db.VarChar(100)
  trendData      Json
  sampleSize     Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  // 확장 필드
  trendSummary   Json?       // { difficultyLevel, characteristics, focusAreas }
  aiInsight      String?     @db.Text
  topicFrequency Json?       // [{topic, count, pct, avgDifficulty, totalPoints}]

  @@index([tenantId, subject, grade])
  @@index([period])
  @@index([schoolName])
}

model ExamQuestionReference {
  id             String      @id @default(cuid())
  subject        ExamSubject
  grade          String      @db.VarChar(30)
  difficulty     String      @db.VarChar(20)
  questionType   String      @db.VarChar(30)
  content        String      @db.Text
  answer         String?     @db.Text
  source         String?     @db.VarChar(200)
  metadata       Json?
  createdAt      DateTime    @default(now())

  // 자동수집 + 검토 워크플로 필드
  reviewStatus   String      @default("pending") @db.VarChar(20) // pending, approved, rejected
  examPaperId    String?
  analysisId     String?
  questionNumber Int?
  confidence     Float?
  topicHierarchy String?     @db.VarChar(300)
  reviewedAt     DateTime?
  reviewedBy     String?
  reviewNote     String?     @db.Text

  @@index([subject, grade])
  @@index([difficulty])
  @@index([reviewStatus])
  @@index([examPaperId])
}

// ── 피드백 시스템 (선생님 교정 → 학습 루프) ──

model ExamFeedback {
  id             String   @id @default(cuid())
  tenantId       String
  examPaperId    String
  analysisId     String?
  questionNumber Int?
  feedbackType   String   @db.VarChar(30) // wrong_topic, wrong_difficulty, wrong_recognition, other
  correction     Json?
  comment        String?  @db.Text
  teacherId      String
  status         String   @default("pending") @db.VarChar(20) // pending, processed, applied
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([tenantId])
  @@index([examPaperId])
  @@index([status])
  @@index([feedbackType])
}

model LearnedPattern {
  id            String      @id @default(cuid())
  subject       ExamSubject
  patternType   String      @db.VarChar(30) // topic_review, difficulty_adjust, type_correction
  description   String      @db.Text
  confidence    Float       @default(0.5)
  sourceCount   Int         @default(1)
  rule          Json?
  isAutoApplied Boolean     @default(false)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([subject, patternType])
  @@index([isActive, isAutoApplied])
}

// ══════════════════════════════════════════════════════════════
// FEAT: 내신대비 자동학습 시스템 (Exam Campaign)
// ══════════════════════════════════════════════════════════════

enum ExamCampaignType {
  MIDTERM     // 중간고사
  FINAL       // 기말고사
  PERFORMANCE // 수행평가 (확장용)
}

enum ExamCampaignStatus {
  PREPARING  // 큐레이션 진행 중
  ACTIVE     // 학생 학습 중
  COMPLETED  // 시험 후 종료
  ARCHIVED   // 보관
}

/// 내신 시험을 D-day까지 자동 학습으로 준비하는 캠페인.
/// 선생님이 학교+학년+시험구분+범위를 지정하면, 큐레이터가
/// 같은/인근 학교 기출 + 단원 매칭 문제 + 출제 패턴을 모아 캠페인 풀을 만든다.
model ExamCampaign {
  id              String              @id @default(cuid())
  seq             Int                 @unique @default(autoincrement())
  tenantId        String
  classroomId     String?
  schoolId        String?
  schoolName      String?             @db.VarChar(100)
  title           String              @db.VarChar(200)
  grade           String              @db.VarChar(30)   // "middle_2", "high_algebra" 등
  semester        Int                                    // 1 | 2 (고등은 0)
  examType        ExamCampaignType
  examDate        DateTime            @db.Date           // 시험일 (D-day 기준)
  isDateTentative  Boolean            @default(false)    // 임시 시험일 여부 (학교 공지 전 추정)
  isScopeTentative Boolean            @default(false)    // 임시 시험범위 여부 (확정 전 예상 범위)
  scopeChapters   Json                                    // [{chapter: string, sections?: string[]}]
  status          ExamCampaignStatus  @default(PREPARING)

  // 큐레이션 결과 (curator 1회 실행)
  curatedQuestionIds Json?            // string[]  (기출 + 매칭 문제)
  curatedConceptIds  Json?            // string[]  (시험범위 개념)
  patternAnalysis    Json?            // PatternAnalysis 구조 (출제 빈도/난이도/킬러유형)
  curatedAt          DateTime?

  createdById     String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id])
  classroom   Classroom?  @relation(fields: [classroomId], references: [id])
  school      School?     @relation(fields: [schoolId], references: [id])
  createdBy   User        @relation("ExamCampaignCreator", fields: [createdById], references: [id])
  enrollments ExamCampaignEnrollment[]

  @@index([tenantId])
  @@index([classroomId])
  @@index([status])
  @@index([examDate])
  @@index([tenantId, status])
}

/// 학생별 캠페인 등록. P2에서 schedule(D-day 일정)이 자동 생성된다.
model ExamCampaignEnrollment {
  id              String       @id @default(cuid())
  campaignId      String
  studentId       String
  status          String       @default("ACTIVE") @db.VarChar(20) // ACTIVE | COMPLETED | DROPPED
  schedule        Json?        // [{dayIndex, date, phase, activities: [{type, refId, completed}]}]
  weakChapters    Json?        // string[]
  progressPct     Int          @default(0)
  predictedGrade  String?      @db.VarChar(10)
  startedAt       DateTime?
  completedAt     DateTime?
  enrolledAt      DateTime     @default(now())

  campaign  ExamCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  student   User         @relation("ExamCampaignEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([campaignId, studentId])
  @@index([studentId])
  @@index([campaignId])
}

// ── 반 대항전 주간 결과 ──

model ClassCompetitionWeek {
  id           String   @id @default(cuid())
  tenantId     String
  weekStart    DateTime
  weekEnd      DateTime
  results      Json     // [{ classroomId, name, totalXp, memberCount, rank }]
  winnerId     String?
  bonusAwarded Boolean  @default(false)
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, weekStart])
  @@index([tenantId])
}

// ────────────────────────────────────────────────────
// 학생 자습 엔진 대개조 — 신규 모델
// ────────────────────────────────────────────────────

/// 답 보기/힌트 사용 로그 — hidden_answer 뱃지 조건용
model RevealLog {
  id        String   @id @default(cuid())
  userId    String
  kind      String   @db.VarChar(30)   // 'hint' | 'answer_reveal' | 'auto_reveal'
  referenceId String? @db.VarChar(100) // questionId 등 (옵션)
  createdAt DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
}

/// 일일 가차/룰렛 결과 — 학생당 하루 1회
model DailyRoulette {
  id          String   @id @default(cuid())
  studentId   String
  date        DateTime @db.Date
  rewardType  String   @db.VarChar(30)  // 'xp_small' | 'xp_medium' | 'xp_large' | 'streak_freeze' | 'badge_shard' | 'jackpot'
  rewardValue Int      @default(0)       // 실제 지급된 값 (XP 등)
  rewardMeta  Json?                      // 추가 메타 정보
  createdAt   DateTime @default(now())

  @@unique([studentId, date])
  @@index([studentId, date(sort: Desc)])
}

/// AI 튜터 챗 로그 — Rate limit 및 이력 추적
model TutorChatLog {
  id         String   @id @default(cuid())
  userId     String
  questionId String?
  studentQ   String   @db.Text  // 학생 질문 (또는 "AI에게 물어보기" 자동 생성)
  aiAnswer   String   @db.Text  // AI 응답
  createdAt  DateTime @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([questionId])
}

